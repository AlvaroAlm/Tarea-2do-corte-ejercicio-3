#include <iostream>
#include <stdexcept>
#include <mutex>
#include <optional>
using namespace std;

// Exercism: bank-account
// Simulate a bank account that can be opened, closed, deposited into,
// and withdrawn from. Thread-safe via mutex.
// Throws domain_error if operations are attempted on a closed account.

class BankAccount {
private:
    optional<double> balance;
    mutable mutex mtx;

public:
    BankAccount() : balance(nullopt) {}

    void open() {
        lock_guard<mutex> lock(mtx);
        if (balance.has_value())
            throw domain_error("account already open");
        balance = 0.0;
    }

    void close() {
        lock_guard<mutex> lock(mtx);
        if (!balance.has_value())
            throw domain_error("account not open");
        balance = nullopt;
    }

    double getBalance() const {
        lock_guard<mutex> lock(mtx);
        if (!balance.has_value())
            throw domain_error("account not open");
        return *balance;
    }

    void deposit(double amount) {
        lock_guard<mutex> lock(mtx);
        if (!balance.has_value())
            throw domain_error("account not open");
        if (amount <= 0)
            throw domain_error("invalid amount");
        *balance += amount;
    }

    void withdraw(double amount) {
        lock_guard<mutex> lock(mtx);
        if (!balance.has_value())
            throw domain_error("account not open");
        if (amount <= 0)
            throw domain_error("invalid amount");
        if (amount > *balance)
            throw domain_error("insufficient funds");
        *balance -= amount;
    }

    bool isOpen() const {
        lock_guard<mutex> lock(mtx);
        return balance.has_value();
    }
};

// Helper to run tests
void runTest(const string& desc, bool condition) {
    cout << (condition ? "[PASS] " : "[FAIL] ") << desc << endl;
}

void testThrows(const string& desc, auto func) {
    try {
        func();
        cout << "[FAIL] " << desc << " (expected exception)" << endl;
    } catch (const domain_error& e) {
        cout << "[PASS] " << desc << " (threw: " << e.what() << ")" << endl;
    }
}

int main() {
    cout << "=== Exercism: bank-account ===" << endl << endl;

    // Test 1: Basic open/close
    {
        BankAccount acc;
        acc.open();
        runTest("Account opens successfully", acc.isOpen());
        runTest("Initial balance is 0", acc.getBalance() == 0.0);
        acc.close();
        runTest("Account closes successfully", !acc.isOpen());
    }

    // Test 2: Deposit and withdraw
    {
        BankAccount acc;
        acc.open();
        acc.deposit(1000.0);
        runTest("Deposit 1000 -> balance = 1000", acc.getBalance() == 1000.0);
        acc.deposit(500.0);
        runTest("Deposit 500 -> balance = 1500", acc.getBalance() == 1500.0);
        acc.withdraw(300.0);
        runTest("Withdraw 300 -> balance = 1200", acc.getBalance() == 1200.0);
        acc.close();
    }

    // Test 3: Errors
    cout << endl;
    {
        BankAccount acc;
        testThrows("Get balance on closed account", [&]{ acc.getBalance(); });
        testThrows("Deposit on closed account",     [&]{ acc.deposit(100); });
        testThrows("Withdraw on closed account",    [&]{ acc.withdraw(50); });

        acc.open();
        testThrows("Negative deposit",    [&]{ acc.deposit(-10); });
        testThrows("Zero deposit",        [&]{ acc.deposit(0); });
        testThrows("Overdraft",           [&]{ acc.withdraw(1000); });
        testThrows("Double open",         [&]{ acc.open(); });
        acc.close();
        testThrows("Double close",        [&]{ acc.close(); });
    }

    // Test 4: Multiple transactions scenario
    cout << endl << "--- Transaction scenario ---" << endl;
    {
        BankAccount acc;
        acc.open();
        cout << "Start balance: " << acc.getBalance() << endl;
        acc.deposit(5000.0);
        cout << "After deposit $5000: " << acc.getBalance() << endl;
        acc.withdraw(200.0);
        cout << "After withdraw $200: " << acc.getBalance() << endl;
        acc.deposit(1500.0);
        cout << "After deposit $1500: " << acc.getBalance() << endl;
        acc.withdraw(acc.getBalance()); // drain account
        cout << "After draining: " << acc.getBalance() << endl;
        acc.close();
        cout << "Account closed." << endl;
    }

    return 0;
}
